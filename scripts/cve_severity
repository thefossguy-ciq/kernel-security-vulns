#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
#
# cve_severity - list the CVEs a kernel version is vulnerable to, together
#		 with their CVSS score, filtered by a minimum severity.
#
# Usage:
#	cve_severity KERNEL_VERSION SEVERITY
#
#	KERNEL_VERSION	git id in CVEKERNELTREE, e.g. v6.18.40 or 6.18.40
#	SEVERITY	minimum CVSS base score (e.g. 7 or 8.5) or one of
#			CRITICAL, HIGH, MEDIUM, LOW
#
# Requires:
#	CVEKERNELTREE set, tools built with 'just build_utils', jq

set -o errexit
set -o nounset
set -o pipefail

TOP=20

help()
{
	echo "Usage: $0 KERNEL_VERSION SEVERITY"
	echo "    KERNEL_VERSION  git id in CVEKERNELTREE, e.g. v6.18.40"
	echo "    SEVERITY        minimum score (e.g. 7) or CRITICAL|HIGH|MEDIUM|LOW"
	exit 1
}

[[ $# -ne 2 ]] && help

DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
VULNS="${DIR}/.."
STRAK="${DIR}/strak"

version="$1"
[[ "${version}" =~ ^[0-9] ]] && version="v${version}"

case "${2^^}" in
	CRITICAL)	min=9.0 ;;
	HIGH)		min=7.0 ;;
	MEDIUM)		min=4.0 ;;
	LOW)		min=0.1 ;;
	*)
		[[ "$2" =~ ^[0-9]+(\.[0-9]+)?$ ]] || help
		min="$2"
		;;
esac

if [[ ! -x "${STRAK}" ]]; then
	echo "${STRAK} not found, run 'just build_utils' first" >&2
	exit 1
fi
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

OUT="${TMPDIR:-/tmp}/cve_severity-${version}"
mkdir -p "${OUT}"
VULN_FILE="${OUT}/strak-${version}.txt"
SEV_FILE="${OUT}/cve-list-severity.txt"
RESULT_FILE="${OUT}/result-${version}-${min}.txt"

echo "# Running strak on ${version}"
"${STRAK}" "${version}" > "${VULN_FILE}"

echo "# Building the CVE severity list"
find "${VULNS}/cve/published" -name 'CVE-*.json' -exec jq -r '
	.containers.cna.metrics[0].cvssV3_1 // empty |
	[input_filename, .baseScore, .baseSeverity] | @tsv' {} + |
	sed 's|^.*/\(CVE-[0-9]*-[0-9]*\)\.json|\1|' |
	sort -t$'\t' -k2,2nr > "${SEV_FILE}"

awk -v min="${min}" '
	NR == FNR { score[$1] = $2; sev[$1] = $3; next }
	match($0, /CVE-[0-9]+-[0-9]+/) {
		cve = substr($0, RSTART, RLENGTH)
		total++
		if (!(cve in score)) { unscored++; next }
		if (score[cve] + 0 >= min + 0)
			print cve "\t" score[cve] "\t" sev[cve]
	}
	END {
		printf("%d vulnerable, %d without a kernel CVSS score\n",
		       total, unscored) > "/dev/stderr"
	}' "${SEV_FILE}" "${VULN_FILE}" |
	sort -t$'\t' -k2,2nr -k1,1 | column -t > "${RESULT_FILE}"

count=$(wc -l < "${RESULT_FILE}")
echo "# ${count} CVEs in ${version} with score >= ${min}, top ${TOP}:"
head -n "${TOP}" "${RESULT_FILE}"
echo
echo "# strak output:   ${VULN_FILE}"
echo "# severity list:  ${SEV_FILE}"
echo "# full result:    ${RESULT_FILE}"
